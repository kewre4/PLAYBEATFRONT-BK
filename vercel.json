{
    "version": 2,
    "root": "frntbk/2",
    "buildCommand": "npm install && npm run build",
    "outputDirectory": "dist",
    "env": {
        "VITE_API_URL": "https://api.playbeat.digital",
        "VITE_STRIPE_PUBLISHABLE_KEY": "pk_test_51TMvD1K7C5jIjluKwjpb2ZJzlZoH4I9hxOwbcZkXr15wNvaLLX7wHpfeTw6Eu09O0aZDCpWo6ptHvoQjhloFApJ200lkcdWYVw"
    },
    "routes": [
        {
            "src": "^/api/(.*)",
            "dest": "https://api.playbeat.digital/api/$1",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ]
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/unified",
            "dest": "/playbeat_unified_fixed.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}