{
    "version": 2,
    "name": "playbeat-frontend",
    "regions": [
        "iad1"
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "env": {
        "VITE_API_URL": {
            "default": "https://api.playbeat.digital"
        }
    },
    "routes": [
        {
            "src": "^/api/(.*)",
            "dest": "https://api.playbeat.digital/api/$1",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ]
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/unified",
            "dest": "/playbeat_unified_fixed.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, must-revalidate"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ]
}